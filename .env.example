# Neon: conexión con pooling (host con -pooler). Obligatoria.
DATABASE_URL=
# Neon: conexión directa (mismo host sin -pooler). Opcional, se usa para migrar.
DATABASE_URL_UNPOOLED=

# Mails (enlace para entrar e invitaciones) con Resend. Sin esto, la app muestra
# el enlace para copiar y mandar por WhatsApp.
RESEND_API_KEY=
EMAIL_FROM="Tranquera <hola@tudominio.com>"

# Dirección pública de la app para armar enlaces (en Vercel se detecta sola).
APP_URL=

# Poné "false" para que solo se pueda entrar con invitación.
ALLOW_SIGNUP=true
